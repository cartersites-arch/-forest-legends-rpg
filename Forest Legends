      <button class="bigbtn" onclick="newGame()">NEW GAME</button>
      <button id="continueBtn" class="bigbtn secondary hidden" onclick="continueGame()">CONTINUE</button>
      <p class="small">Designed for phone screens. Tap choices to play. Progress saves automatically in Safari.</p>
    </div>
  </section>

  <section id="gameScreen" class="screen">
    <div class="hero">
      <img id="sceneImg" src="images/scene1.jpg" alt="Game scene">

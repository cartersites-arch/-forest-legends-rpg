  </section>
</div>
<div id="toast" class="toast"></div>

<script>
const IMAGES = ["images/scene1.jpg", "images/scene2.jpg", "images/scene3.jpg", "images/scene4.jpg", "images/scene5.jpg", "images/scene6.jpg", "images/scene7.jpg"];


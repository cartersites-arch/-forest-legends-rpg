let state = null;
let currentScene = "start";
let battle = null;

function defaultState(){
  return {
    hp:10,maxHp:10,level:1,xp:0,coins:5,shards:0,
    abilities:[],inventory:{"Flashlight":1,"Pocketknife":1,"Snack bar":1},
    flags:{}, scene:"start"
  };
}

function save(){
  if(!state) return;
  state.scene=currentScene;
  localStorage.setItem("forestLegendsSave", JSON.stringify(state));
}

function hasSave(){ return !!localStorage.getItem("forestLegendsSave"); }

function newGame(){
  state=defaultState();
  currentScene="start";
  battle=null;
  show("gameScreen");
  renderScene(true);
}

function continueGame(){
  try{state=JSON.parse(localStorage.getItem("forestLegendsSave"))||defaultState();}
  catch(e){state=defaultState();}
  currentScene=state.scene||"start";
  battle=null;
  show("gameScreen");
  renderScene(false);
}

function gainXP(n){
  if(!state) return;
  state.xp += n;
  const need = state.level*100;
  if(state.xp >= need){
    state.xp -= need;
    state.level += 1;
    state.maxHp += 2;
    state.hp = state.maxHp;
    toast("â­ LEVEL UP! Level "+state.level);
  }
}

function damage(n){
  state.hp=Math.max(0,state.hp-n);
  if(state.hp===0) state.hp=1;
}

function addAbility(name){
  if(!state.abilities.includes(name)) state.abilities.push(name);
}

function getShard(n){
  if(state.shards < n){
    state.shards=n;
    gainXP(35);
    toast("ð Crystal Shard #"+n+" acquired");
  }
}

function show(id){
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
}

function choose(next){
  currentScene=next;
  battle=null;
  renderScene(true);
}

function renderScene(runEnter){
  const s=scenes[currentScene];
  if(!s) return;
  document.getElementById("chapter").textContent=s.chapter;
  document.getElementById("sceneTitle").textContent=s.title;
  document.getElementById("sceneImg").src=IMAGES[s.img||0];
  document.getElementById("story").textContent=s.text;
  document.getElementById("notice").classList.add("hidden");
  document.getElementById("enemyBox").classList.add("hidden");

  if(runEnter && s.enter && !state.flags["entered_"+currentScene]){
    s.enter();
    state.flags["entered_"+currentScene]=true;
  }

  if(s.battle){
    battle={...s.battle};
    renderBattle();
  } else {
    renderChoices(s);
  }
  updateStats();
  save();
}

function renderChoices(s){
  const box=document.getElementById("choices");
  box.innerHTML="";
  if(s.end){
    const b=document.createElement("button");
    b.className="choice";
    b.textContent="ð PLAY AGAIN";
    b.onclick=newGame;
    box.appendChild(b);
    return;
  }
  s.choices.forEach(([label,next])=>{
    const b=document.createElement("button");
    b.className="choice";
    b.textContent=label;
    b.onclick=()=>choose(next);
    box.appendChild(b);
  });
}

function renderBattle(){
  const box=document.getElementById("enemyBox");
  box.classList.remove("hidden");
  document.getElementById("enemyName").textContent=battle.name;
  refreshEnemy();
  const choices=document.getElementById("choices");
  choices.innerHTML="";
  [
    ["âï¸ ATTACK",()=>playerAttack()],
    ["â¨ UNICORN FLASH",()=>magicAttack()],
    ["ð« USE SNACK",()=>snackHeal()]
  ].forEach(([t,fn],i)=>{
    const b=document.createElement("button");
    b.className="choice"+(i===0?" danger":"");
    b.textContent=t;
    b.onclick=fn;
    choices.appendChild(b);
  });
}

function playerAttack(){
  if(!battle) return;
  const dmg=2+Math.floor(Math.random()*4)+Math.floor(state.level/2);
  battle.hp=Math.max(0,battle.hp-dmg);
  toast("âï¸ You hit for "+dmg);
  if(battle.hp<=0) return winBattle();
  enemyTurn();
}

function magicAttack(){
  if(!battle) return;
  if(!state.abilities.some(a=>a.includes("Unicorn"))){
    toast("You haven't learned Unicorn Flash yet.");
    return;
  }
  const dmg=5+Math.floor(Math.random()*4);
  battle.hp=Math.max(0,battle.hp-dmg);
  toast("â¨ Unicorn Flash hits for "+dmg);
  if(battle.hp<=0) return winBattle();
  enemyTurn();
}

function snackHeal(){
  const snack = state.inventory["Half snack bar"] || state.inventory["Snack bar"];
  if(!snack){toast("No snack left. Civilization collapses.");return;}
  state.hp=Math.min(state.maxHp,state.hp+4);
  if(state.inventory["Half snack bar"]) delete state.inventory["Half snack bar"];
  else delete state.inventory["Snack bar"];
  toast("ð« +4 HP");
  enemyTurn();
}

function enemyTurn(){
  const dmg=1+Math.floor(Math.random()*3);
  state.hp=Math.max(0,state.hp-dmg);
  if(state.hp<=0){
    state.hp=Math.max(1,Math.floor(state.maxHp/2));
    toast("ð You got flattened. Bigfoot drags you to safety.");
  } else toast("ð¥ "+battle.name+" hits for "+dmg);
  refreshEnemy();
  updateStats();
  save();
}

function winBattle(){
  gainXP(40);
  toast("ð "+battle.name+" defeated");
  const next=battle.next;
  battle=null;
  setTimeout(()=>choose(next),500);
}

function refreshEnemy(){
  document.getElementById("enemyHpText").textContent=battle.hp+" / "+battle.maxHp+" HP";
  document.getElementById("enemyHpBar").style.width=(battle.hp/battle.maxHp*100)+"%";
}

function updateStats(){
  document.getElementById("hpText").textContent=state.hp+"/"+state.maxHp;
  document.getElementById("levelText").textContent=state.level;
  document.getElementById("xpText").textContent=state.xp;
  document.getElementById("shardsText").textContent=state.shards+"/3";
}

function openMenu(){
  if(!state) return;
  renderMenu();
  show("menuScreen");
}

function closeMenu(){
  if(!state){show("titleScreen");return;}
  show("gameScreen");
}

function renderMenu(){
  const inv=document.getElementById("inventory");
  inv.innerHTML="";
  Object.entries(state.inventory).forEach(([k,v])=>{
    const d=document.createElement("div");
    d.className="inv";
    d.innerHTML="<b>"+k+"</b><br><span class='small'>x"+v+"</span>";
    inv.appendChild(d);
  });
  const pills=document.getElementById("abilityPills");
  pills.innerHTML=(state.abilities.length?state.abilities:["No special abilities yet"]).map(x=>"<span class='pill'>"+x+"</span>").join("");
}

function confirmReset(){
  if(confirm("Reset Forest Legends and erase saved progress?")){
    localStorage.removeItem("forestLegendsSave");
    state=null; battle=null; currentScene="start";
    document.getElementById("continueBtn").classList.add("hidden");
    show("titleScreen");
  }
}

function toast(msg){
  const t=document.getElementById("toast");
  t.textContent=msg;
  t.classList.add("show");
  clearTimeout(window.__toastTimer);
  window.__toastTimer=setTimeout(()=>t.classList.remove("show"),1400);
}

window.addEventListener("load",()=>{
  if(hasSave()) document.getElementById("continueBtn").classList.remove("hidden");
});
</script>
</body>
</html>

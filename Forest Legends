        <div id="chapter" class="chapter">Chapter 1</div>
        <div id="sceneTitle" class="title">Something in the Woods</div>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><b id="hpText">10/10</b><small>â¤ï¸ HP</small></div>
      <div class="stat"><b id="levelText">1</b><small>â­ LEVEL</small></div>
      <div class="stat"><b id="xpText">0</b><small>â¨ XP</small></div>

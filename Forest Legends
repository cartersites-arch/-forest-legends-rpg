<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0d1f16">
<title>Forest Legends RPG</title>
<style>
:root {
  --bg:#09140e;
  --panel:#12251a;
  --panel2:#183321;
  --text:#f7fff9;
  --muted:#b8c9bd;
  --accent:#ffe06b;
  --green:#69d18a;
  --danger:#ff7d7d;
  --line:rgba(255,255,255,.12);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
body{min-height:100vh;background:
radial-gradient(circle at 10% 10%,rgba(90,255,150,.12),transparent 28%),
radial-gradient(circle at 90% 20%,rgba(255,220,100,.10),transparent 25%),
linear-gradient(180deg,#0c1c13,#08110c 70%)}
#app{max-width:760px;margin:0 auto;min-height:100vh;padding:calc(env(safe-area-inset-top) + 10px) 12px calc(env(safe-area-inset-bottom) + 18px)}
.topbar{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-bottom:10px}
.logo{font-weight:900;letter-spacing:.4px;font-size:18px}
.iconbtn{border:1px solid var(--line);background:rgba(255,255,255,.07);color:var(--text);border-radius:12px;padding:9px 11px;font-weight:800}
.hero{position:relative;overflow:hidden;border-radius:22px;border:1px solid var(--line);box-shadow:0 18px 50px rgba(0,0,0,.35);background:#111;min-height:280px}
.hero img{width:100%;height:42vh;max-height:430px;min-height:280px;object-fit:cover;display:block}
.fade{position:absolute;left:0;right:0;bottom:0;padding:50px 16px 16px;background:linear-gradient(transparent,rgba(0,0,0,.88))}
.chapter{font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#d9e6dc;font-weight:900}
.title{font-size:28px;line-height:1.05;font-weight:950;margin-top:4px;text-shadow:0 2px 10px rgba(0,0,0,.55)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0}
.stat{background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:14px;padding:9px 7px;text-align:center}
.stat b{display:block;font-size:16px} .stat small{color:var(--muted);font-size:10px}
.card{background:linear-gradient(180deg,var(--panel),#0f2117);border:1px solid var(--line);border-radius:18px;padding:14px;margin-top:10px;box-shadow:0 12px 30px rgba(0,0,0,.22)}
.story{font-size:17px;line-height:1.5;white-space:pre-line}
.choices{display:grid;gap:9px;margin-top:12px}
.choice{width:100%;border:0;border-radius:16px;padding:15px 14px;text-align:left;font-size:16px;font-weight:900;background:linear-gradient(180deg,#e9ffe5,#cfeac7);color:#102016;box-shadow:0 5px 0 #8aa67e;touch-action:manipulation}
.choice:active{transform:translateY(3px);box-shadow:0 2px 0 #8aa67e}
.choice.danger{background:linear-gradient(180deg,#ffe4e4,#ffc9c9);box-shadow:0 5px 0 #b57a7a;color:#341616}
.pillrow{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}
.pill{background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:999px;padding:7px 10px;font-size:12px;font-weight:800}
.bar{height:9px;background:#27352d;border-radius:99px;overflow:hidden;margin-top:5px}
.fill{height:100%;background:var(--green);width:100%;transition:width .3s}
.enemy .fill{background:var(--danger)}
.notice{border-left:4px solid var(--accent);padding:10px 12px;background:rgba(255,224,107,.08);border-radius:12px;margin-top:10px;font-size:14px}
.hidden{display:none!important}
.screen{display:none} .screen.active{display:block}
.center{text-align:center}
.bigbtn{width:100%;border:0;border-radius:18px;padding:17px;font-size:18px;font-weight:950;background:var(--accent);color:#332800;box-shadow:0 6px 0 #a78f38;margin-top:10px}
.secondary{background:#d9e5dc;box-shadow:0 6px 0 #819487;color:#152019}
.reset{background:#4c1717;color:#ffdada;box-shadow:0 6px 0 #2c0d0d}
.small{color:var(--muted);font-size:13px;line-height:1.4}
.invgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.inv{border:1px solid var(--line);border-radius:14px;padding:10px;background:rgba(255,255,255,.05)}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(env(safe-area-inset-bottom) + 18px);z-index:50;background:#111f16;color:white;padding:10px 14px;border-radius:999px;border:1px solid var(--line);box-shadow:0 10px 30px rgba(0,0,0,.4);font-size:13px;font-weight:800;opacity:0;pointer-events:none;transition:opacity .2s;white-space:nowrap;max-width:90vw;overflow:hidden;text-overflow:ellipsis}
.toast.show{opacity:1}
@media (max-width:390px){.title{font-size:24px}.story{font-size:16px}.choice{font-size:15px}.stats{gap:5px}}
</style>
</head>
<body>
<div id="app">
  <div class="topbar">
    <div class="logo">ð² FOREST LEGENDS RPG</div>
    <button class="iconbtn" onclick="openMenu()">â°</button>
  </div>

  <section id="titleScreen" class="screen active">
